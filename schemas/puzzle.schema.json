{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Author proposal for the predictable-mistake experiment",
  "description": "Model output only. Assignment, identity, provenance, validation and run records are added by the harness. This schema does not establish game validity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "board", "solution", "predicted_first_push", "forecasts", "mechanism", "diagnostic_warning"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "board": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"type": "string", "minLength": 7, "maxLength": 7, "pattern": "^[#_.$*@+]{7}$"}
    },
    "solution": {"$ref": "#/$defs/plan"},
    "predicted_first_push": {"$ref": "#/$defs/push"},
    "forecasts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["solver_id", "p_predicted_first_push", "p_full_solution"],
        "properties": {
          "solver_id": {"type": "string", "minLength": 1},
          "p_predicted_first_push": {"type": "number", "minimum": 0, "maximum": 1},
          "p_full_solution": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "mechanism": {"type": "string", "minLength": 1, "maxLength": 1200},
    "diagnostic_warning": {"type": "string", "minLength": 1, "maxLength": 500}
  },
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "integer", "minimum": 0, "maximum": 6}
    },
    "push": {
      "type": "object",
      "additionalProperties": false,
      "required": ["box", "direction"],
      "properties": {
        "box": {"$ref": "#/$defs/position"},
        "direction": {"enum": ["up", "down", "left", "right"]}
      }
    },
    "plan": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {"$ref": "#/$defs/push"}
    }
  },
  "$comment": "Runtime checks: perimeter walls; exactly one player; 2-3 boxes; equal goals; nonterminal start; witness replay; optimum bounds; predicted push legal and exhaustively certified deadlocking; canonical deduplication; forecast IDs equal the frozen roster exactly once; per-model probabilities sum to at most 1; warning <=40 whitespace-delimited words plus blind content review. Structural schema compliance is not a certificate of validity."
}
